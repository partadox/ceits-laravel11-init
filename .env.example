APP_NAME="CEITS Prisma Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8081
APP_PORT=8081

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Database - PostgreSQL External
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ceits_prisma_laravel
DB_USERNAME=postgres
DB_PASSWORD=

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache
CACHE_STORE=file
CACHE_PREFIX=

# CEITS SSO Configuration
SSO_API_URL=http://localhost:3004
SSO_API_KEY=your_api_key_here
SSO_COOKIE_NAME=ceits_sso_token
SSO_FRONTEND_URL=http://localhost:3000

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
